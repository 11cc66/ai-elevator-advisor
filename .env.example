# Copy this file to .env and replace the connection URL locally.
# Never commit .env or a real password.
#
# If the password contains URL-reserved characters, URL-encode it before
# placing it in DATABASE_URL. For example, @ becomes %40.
DATABASE_URL=postgresql://elevator_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/elevator_advisor?schema=public

# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://127.0.0.1:3000
WORKER_QUEUE_NAME=system-jobs

# Better Auth. Use a random secret of at least 32 characters.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS

# Development-only seed account. These values are never committed to source.
DEV_ADMIN_USERNAME=dev_admin
DEV_ADMIN_NAME=开发管理员
DEV_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_DEVELOPMENT_PASSWORD
