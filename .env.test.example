# Copy to .env.test and fill all values locally.
# Never commit .env.test or send these values to another person.

# Dedicated, disposable database. This must not equal DATABASE_URL in .env.
TEST_DATABASE_URL=postgresql://elevator_test_app:REPLACE_WITH_URL_ENCODED_TEST_PASSWORD@127.0.0.1:5432/elevator_advisor_test?schema=public
TEST_DATABASE_ROLE=elevator_test_app
TEST_DATABASE_NAME=elevator_advisor_test
TEST_DATABASE_MARKER=REPLACE_WITH_A_RANDOM_MARKER_OF_AT_LEAST_32_CHARS
TEST_DATABASE_CONFIRMATION=elevator_advisor_test
ALLOW_TEST_DB_INIT=true
ALLOW_TEST_DB_RESET=true

# Test web server uses a separate port so it cannot reuse the development server.
TEST_APP_BASE_URL=http://127.0.0.1:3100
TEST_PRIVATE_STORAGE_ROOT=storage/private-test
PDF_MAX_PAGES=200
PDF_MAX_TEXT_CHARS=2000000
IMAGE_MAX_PIXELS=40000000
PDF_PARSE_TIMEOUT_MS=60000
FILE_PROCESSING_MAX_ATTEMPTS=3
FILE_PROCESSING_RETRY_DELAY_SECONDS=5
FILE_PROCESSING_RETRY_MAX_SECONDS=60
FILE_PROCESSING_JOB_EXPIRE_SECONDS=180
FILE_PROCESSING_LEASE_MS=120000
FILE_PROCESSING_LEASE_RENEW_INTERVAL_MS=30000
FILE_MAINTENANCE_LEASE_MS=300000
FILE_MAINTENANCE_RENEW_INTERVAL_MS=60000
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_TEST_SECRET_OF_AT_LEAST_32_CHARS

# Test environment credentials. Use different values from development credentials.
TEST_ADMIN_USERNAME=test_admin
TEST_ADMIN_NAME=测试管理员
TEST_ADMIN_PASSWORD=REPLACE_WITH_A_TEST_ADMIN_PASSWORD_OF_AT_LEAST_12_CHARS

TEST_CUSTOMER_USERNAME=test_customer
TEST_CUSTOMER_NAME=测试客户
TEST_CUSTOMER_PASSWORD=REPLACE_WITH_A_TEST_CUSTOMER_PASSWORD_OF_AT_LEAST_12_CHARS
TEST_CUSTOMER_2_USERNAME=test_customer_2
TEST_CUSTOMER_2_NAME=测试客户二
